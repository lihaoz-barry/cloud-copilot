# cloud-copilot deploy configuration — App Store Connect / fastlane.
#
# Copy this file to  ~/.config/cloud-copilot/deploy.env  and fill in real values.
# setup/setup.sh does this for you. NEVER commit the filled-in file (it is gitignored).
#
# These identifiers are consumed by the bundled `testflight-deploy` skill and by
# your app's fastlane lane. The .p8 private key is the only true secret and lives
# under ~/.appstoreconnect/private_keys/ — never here, never in git.

# --- App Store Connect API key (Team Keys → App Manager role) ---
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
# Where you keep the downloaded .p8 (OUTSIDE any git repo). setup.sh copies it to
# ~/.appstoreconnect/private_keys/AuthKey_${ASC_KEY_ID}.p8
ASC_KEY_P8_SOURCE=$HOME/Downloads/AuthKey_XXXXXXXXXX.p8

# --- Signing / app identity ---
APPLE_TEAM_ID=XXXXXXXXXX
APP_BUNDLE_ID=com.example.app
ASC_APP_ID=0000000000

# --- The iOS app repo that gets deployed ---
# Must contain fastlane/Fastfile with a `beta` lane (manual signing via the API key).
APP_REPO=$HOME/repos/your-ios-app
