# cloud-copilot push notifications (ntfy) — machine-local config.
#
# Copy this file to  ~/.config/cloud-copilot/notify.env  and fill it in
# (setup/setup.sh does that for you). Never commit the filled-in file.
#
# When NTFY_TOPIC is empty, cloud-copilot simply doesn't push — no errors,
# no log noise. Every value here can also be supplied as a real environment
# variable, which takes precedence over this file.

# --- Where to publish ---
# Any ntfy server; the public one is the default. Subscribe your phone to the
# same topic in the ntfy app. The topic name IS the password — pick something
# unguessable.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=

# Optional: access token for a protected/self-hosted ntfy instance.
NTFY_TOKEN=

# Set to 0 to keep the config but temporarily mute all pushes.
NTFY_ENABLED=1

# --- Deep links ---
# The URL your phone reaches this app on (LAN/VPN/tunnel), used as the
# notification's tap target so a push jumps straight to the matching repo,
# PR page or admin chat. Leave empty to send notifications with no click action.
# Example: http://your-mac.local:8787
APP_BASE_URL=
